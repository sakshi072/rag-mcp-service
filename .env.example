# ==========================================
# PostgreSQL Configuration
# ==========================================
# Pydantic Settings: Maps to DatabaseSettings
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# MinIO Configuration (Object Storage)
# ==========================================
# Pydantic Settings: Maps to MinIOSettings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=document-storage
MINIO_SECURE=false  # ← Now validated as boolean

# ==========================================
# REDIS Configuration
# ==========================================
REDIS_HOST=localhost
REDIST_PORT=6379

# ==========================================
# Auth0 JWT Validation
# ==========================================
# Pydantic Settings: Maps to Auth0Settings
# Domain format validated (no http://)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=your-api-identifier